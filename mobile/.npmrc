# expo-router@57 depends on vaul/@radix-ui for its *web* renderer, and that
# chain pulls react-dom@19.2.8, whose peer is react@^19.2.8. Expo SDK 57 pins
# react@19.2.3, so npm's strict peer resolution fails every install with
# ERESOLVE.
#
# This app is Android-native only — `expo start --web` is never run, so the
# react-dom branch is dead weight that is never bundled. Bumping react off the
# SDK-pinned version to satisfy a web-only peer would be the riskier fix.
#
# Recorded here rather than left as a flag people must remember, so local
# installs and EAS Build resolve identically. Mirrors the same setting (and the
# same reasoning) in the repository root .npmrc.
legacy-peer-deps=true
