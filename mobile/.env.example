# Copy to .env for local development. EXPO_PUBLIC_* values are inlined into the
# JS bundle when Metro builds it, so they are NOT read at runtime: restart the
# bundler after changing one, and rebuild the APK for a change to reach an
# installed build.
#
# For EAS cloud builds these come from the `env` block in eas.json, not this
# file — .env is not uploaded.

# The backend. Defaults to the deployed Railway API when unset, so the app runs
# against something real out of the box.
#
# To develop against a backend on this machine, use the LAN IP, never
# `localhost` — on the phone that resolves to the phone itself:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=https://backend-production-4cbe.up.railway.app

# The Google OAuth *web* client ID — the same GOOGLE_CLIENT_ID the backend is
# configured with, because the ID token the native SDK mints carries it as the
# `aud` claim that the backend verifies against.
#
# Leave this empty to hide the "Continue with Google" button entirely (useful
# before the Android OAuth client has been registered).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
