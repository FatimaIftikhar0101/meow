# react-simple-maps@3 (used by app/_components/WorldMap.tsx) declares a peer of
# react "^16.8.0 || 17.x || 18.x" and has not been updated for React 19, which
# this app runs. npm's default strict peer resolution therefore fails any
# `npm install` with ERESOLVE.
#
# Recorded here rather than left as a flag people must remember, so local
# installs and CI resolve identically. Revisit when react-simple-maps ships
# React 19 support (or if WorldMap moves to another mapping library).
legacy-peer-deps=true
