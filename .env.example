# Frontend environment. Copy to .env.local (dev) or .env.production (builds).
#
# NEXT_PUBLIC_* values are inlined into the JS bundle at build time — they are
# NOT read at runtime. A static export has no server, and the Capacitor app
# ships as files on the device, so this must be correct *when you build*.
# Changing it means rebuilding and reinstalling the APK.
#
# Must be a public HTTPS URL reachable from a phone. "localhost" resolves to
# the handset itself on a device and will fail.
NEXT_PUBLIC_API_URL=http://localhost:3000
