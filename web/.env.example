# Frontend environment. Copy to .env.local (dev) or .env.production (builds).
#
# NEXT_PUBLIC_* values are inlined into the JS bundle at build time — they are
# NOT read at runtime. A static export has no server to read env vars, so this
# must be correct *when you build*; changing it means rebuilding and
# redeploying.
#
# Set it on the host (Vercel/Netlify project settings, or the CI environment)
# for deployed builds, not just in a local .env file.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Set to "true" to show the "Continue with Google" button. Leave unset when the
# backend has no GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET — it answers 501 in that
# case and the button would always fail. Build-time flag: rebuild to change it.
NEXT_PUBLIC_GOOGLE_ENABLED=false
