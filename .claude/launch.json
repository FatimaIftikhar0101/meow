{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev"
      ],
      "cwd": "backend",
      "port": 3000
    },
    {
      "name": "static-export",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "out",
        "-l",
        "4173"
      ],
      "port": 4173
    }
  ]
}
