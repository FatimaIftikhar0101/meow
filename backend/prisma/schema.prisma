// Meow remittance app — database schema
// Designed for a Canada -> Pakistan remittance corridor (extensible to others).
// Money correctness rules enforced here:
//  - All monetary amounts use Decimal (never floats)
//  - Balances are computed from the LedgerEntry table (double-entry), never stored
//  - Every state-changing action is recorded in AuditLog
//  - Transfers carry an idempotency key to prevent duplicate sends

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String?
  passwordChangedAt   DateTime  @default(now())
  authProvider        String    @default("local")
  googleId            String?   @unique
  // firstName drives the greeting; lastName completes the legal name shown on
  // receipts. Both nullable: accounts created before full name was collected
  // (and Google sign-ups, which only yield a given name) have no value, and
  // the UI falls back to the email local-part.
  firstName           String?
  lastName            String?
  avatarUrl           String?
  emailVerified       Boolean   @default(false)
  // Holds a bcrypt hash of the six-digit code, not a URL token. Attempts are
  // counted because six digits is only safe while guessing is capped.
  emailVerifyToken    String?
  emailVerifyAttempts Int       @default(0)
  emailVerifyExpires  DateTime?
  pwResetToken        String?
  pwResetAttempts     Int       @default(0)
  pwResetExpires      DateTime?
  country             String?
  role                UserRole  @default(customer)
  suspended           Boolean   @default(false)

  // Two-factor, mandatory for every back-office role and unused by customers.
  // The secret is a bearer credential — anyone holding it can mint valid codes
  // forever — so it is encrypted at rest with the same field encryption as
  // account numbers, never stored bare.
  mfaSecret        String?
  // Set only once a code has been proved to work. A secret without this is an
  // enrolment in progress, which must not satisfy the requirement.
  mfaEnabledAt     DateTime?
  // bcrypt hashes, never the codes themselves. Consumed on use.
  mfaRecoveryCodes String[]  @default([])
  // The last time step accepted, so a code cannot be replayed inside its own
  // validity window — the one thing a shoulder-surfer or a proxy needs.
  mfaLastTimeStep  Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  referralCode String? @unique

  ledgerAccounts LedgerAccount[]
  recipients     Recipient[]
  transfers      Transfer[]
  kycRecords     KycRecord[]
  auditLogs      AuditLog[]
  sessions       Session[]
  referralsMade  Referral[]      @relation("ReferrerReferrals")
  referredBy     Referral?       @relation("RefereeReferral")
}

enum UserRole {
  customer

  // Back-office roles. Separate rather than one "staff" flag because the
  // person who processes a payment must not be the person who clears it for
  // AML — segregation of duties is an expectation of a licensed money services
  // business, not internal tidiness. What each can actually do lives in
  // src/auth/permissions.ts; this enum only says which bucket someone is in.
  support
  operations
  compliance
  admin
}

// ─────────────────────────────────────────────────────────────────────────────
// Ledger accounts. A customer wallet is one kind of account among several.
//
// This used to be a `Wallet` table and nothing else, which is why the ledger
// was single-entry: with only customer wallets in existence there was nowhere
// for the other side of a movement to go. Money left a wallet and stopped
// being represented anywhere. Balances still came out right — every wallet
// summed its own rows correctly — but "where is the money when it is not in
// somebody's wallet" had no answer, which is the question a reconciliation
// asks and the first one an auditor asks.
//
// Customer wallets kept their ids through the migration, so every existing
// LedgerEntry still points at the same account it always did.

enum AccountKind {
  /**
   * One per (customer, currency). A liability: we owe them this.
   */
  customer_wallet
  /**
   * Our own cash, per currency. An asset.
   */
  float
  /**
   * Committed to a transfer that has not finished. Neither the customer's
   * any more, nor paid out yet — the balance here is money in flight, and it
   * should trend to zero as transfers settle.
   */
  transfer_suspense
  /**
   * Fees earned. Income. Previously debited from wallets and recorded
   * nowhere, so the business could not say what it had earned.
   */
  fee_revenue
  /**
   * Referral bonuses paid. An expense, for the same reason.
   */
  marketing_expense
  /**
   * Where a transfer's funds land once delivered. Stands in for the payout
   * partner's settlement account until there is a real one.
   */
  payout_settlement
  /**
   * The counterparty invented for entries that predate double-entry. Its
   * balance is exactly the amount of history whose other side was never
   * recorded, which is the honest way to carry that forward.
   */
  opening_balance
}

model LedgerAccount {
  id        String      @id @default(uuid())
  kind      AccountKind
  /**
   * Set only for customer_wallet. Null for every system account.
   */
  ownerId   String?
  currency  String
  /**
   * Stable, readable, and the real uniqueness guarantee: Postgres treats
   * NULLs as distinct, so the composite unique below does not constrain
   * system accounts at all.
   */
  code      String      @unique
  createdAt DateTime    @default(now())

  // Restrict, not Cascade: an account is the anchor for its ledger entries,
  // and removing it would destroy the history those entries constitute.
  owner   User?         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@unique([kind, ownerId, currency])
  @@index([kind, currency])
}

// ─────────────────────────────────────────────────────────────────────────────
// Recipients — people the user sends money to
// ─────────────────────────────────────────────────────────────────────────────

model Recipient {
  id          String   @id @default(uuid())
  userId      String
  name        String
  email       String?
  phone       String?
  country     String // ISO 3166-1 alpha-2: PK, IN, PH, ...
  bankAccount String // IBAN or local account number
  bankName    String?
  bankCode    String? // SWIFT/BIC, IFSC, etc.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict, not Cascade: transfers reference recipients, and a recipient is
  // part of the record of where money went. `remove()` already soft-deletes
  // (active: false) rather than deleting — this stops anything else trying.
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  transfers Transfer[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Corridors — supported send/receive currency pairs with FX + fee config
// ─────────────────────────────────────────────────────────────────────────────

model Corridor {
  id            String  @id @default(uuid())
  fromCurrency  String // CAD
  toCurrency    String // PKR
  fromCountry   String // CA
  toCountry     String // PK
  baseRate      Decimal @db.Decimal(20, 8) // mock provider rate (1 fromCurrency = baseRate toCurrency)
  marginBps     Int     @default(150) // our spread in basis points (150 = 1.5%)
  feeFlat       Decimal @default(0) @db.Decimal(20, 4)
  feePercentBps Int     @default(0)
  minSendAmount Decimal @db.Decimal(20, 4)
  maxSendAmount Decimal @db.Decimal(20, 4)
  active        Boolean @default(true)

  @@unique([fromCurrency, toCurrency])
}

// ─────────────────────────────────────────────────────────────────────────────
// Transfers — the core money-movement record
// ─────────────────────────────────────────────────────────────────────────────

enum TransferStatus {
  initiated
  payment_received
  compliance_check
  fx_converted
  payout_processing
  delivered
  failed
  cancelled
}

model Transfer {
  id          String @id @default(uuid())
  userId      String
  recipientId String

  // ── Beneficiary, snapshotted at creation ──────────────────────────────────
  //
  // Recipients are mutable: a customer can edit a saved recipient's bank
  // account at any time. A transfer is not — it is a record of what actually
  // happened. Reading the beneficiary back through the `recipient` relation
  // meant editing a recipient retroactively rewrote every past transfer to
  // them, so a delivered transfer's receipt would show an account the money
  // had never been sent to.
  //
  // These columns are the beneficiary as it stood the moment the transfer was
  // created. The relation below is kept for grouping and for "send again", but
  // must never be the source of truth for what a transfer did.
  recipientName        String
  recipientCountry     String
  recipientBankAccount String
  recipientBankName    String?
  recipientBankCode    String?

  sendAmount      Decimal        @db.Decimal(20, 4)
  sendCurrency    String
  receiveAmount   Decimal?       @db.Decimal(20, 4)
  receiveCurrency String
  fxRateApplied   Decimal?       @db.Decimal(20, 8)
  feeAmount       Decimal        @default(0) @db.Decimal(20, 4)
  status          TransferStatus @default(initiated)
  idempotencyKey  String         @unique
  providerName    String? // e.g. "mock", "nium", "thunes"
  providerRef     String? // provider's transaction id
  failureReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  recipient      Recipient       @relation(fields: [recipientId], references: [id])
  timeline       TransferEvent[]
  ledgerEntries  LedgerEntry[]
  ledgerPostings LedgerPosting[]

  @@index([userId])
  @@index([recipientId])
  @@index([status])
  // Both the scheduler's "what is due for a tick" query and the operations
  // queue's aging view filter on status and then order by updatedAt. Without
  // this the aging screen is a sequential scan of every transfer ever made,
  // run every time an operator refreshes it.
  @@index([status, updatedAt])
}

model TransferEvent {
  id         String         @id @default(uuid())
  transferId String
  status     TransferStatus
  message    String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Double-entry ledger.
//
// Every movement of money is a POSTING made of two or more ENTRIES that sum to
// zero within one currency. Nothing writes an entry directly: `LedgerService`
// is the only writer, and a Postgres constraint trigger rejects an unbalanced
// posting at COMMIT regardless of what wrote it — because a rule enforced only
// in application code is a rule until somebody opens psql.
//
// Entries are append-only. A correction is a reversing posting, never an edit;
// a second trigger refuses UPDATE and DELETE outright.

enum LedgerDirection {
  debit
  credit
}

enum LedgerEntryType {
  wallet_fund
  transfer_hold
  transfer_release
  transfer_refund
  fee
  fx_conversion
  referral_bonus
}

/// One balanced movement of money. The unit a person reads.
model LedgerPosting {
  id         String   @id @default(uuid())
  /// Deterministic and derived from the event, e.g. "transfer:<id>:hold".
  /// Unique, so replaying an operation cannot post it twice — which the old
  /// `randomUUID()` group id could not prevent, because a retry simply
  /// generated a new one.
  key        String   @unique
  currency   String
  transferId String?
  createdAt  DateTime @default(now())

  transfer Transfer?     @relation(fields: [transferId], references: [id])
  entries  LedgerEntry[]

  @@index([transferId])
  @@index([createdAt])
}

/// One leg of a posting. Balance of an account = sum(credits) - sum(debits).
model LedgerEntry {
  id          String          @id @default(uuid())
  accountId   String
  postingId   String
  transferId  String?
  direction   LedgerDirection
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(20, 4)
  currency    String
  description String?
  createdAt   DateTime        @default(now())

  account  LedgerAccount @relation(fields: [accountId], references: [id])
  // Cascade: an entry cannot outlive its posting, and a posting is never
  // deleted anyway — the immutability trigger sees to that.
  posting  LedgerPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  transfer Transfer?     @relation(fields: [transferId], references: [id])

  @@index([accountId])
  @@index([transferId])
  @@index([postingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// KYC records — abstracted so we can swap mock for Trulioo / Onfido / Persona
// ─────────────────────────────────────────────────────────────────────────────

enum KycStatus {
  pending
  passed
  failed
}

model KycRecord {
  id          String    @id @default(uuid())
  userId      String
  status      KycStatus @default(pending)
  provider    String? // "mock", "trulioo", "onfido", ...
  providerRef String?
  reason      String?
  verifiedAt  DateTime?

  // ── Evidence ──────────────────────────────────────────────────────────────
  //
  // Record-keeping means being able to show *what* was verified, *how*, and
  // *what the provider actually said* — a status column alone proves nothing
  // years later when someone asks how this customer was identified.
  //
  // The current provider is a mock and has no evidence to give, so these stay
  // empty until a real one is wired in. The columns exist now so that
  // integration is a code change rather than a migration against live data.
  verifiedName     String? // name as matched by the provider
  verifiedDob      DateTime? // date of birth as matched
  verifiedAddress  String?
  documentType     String? // passport, drivers_licence, national_id, ...
  documentLast4    String? // never the full number
  documentExpiry   DateTime?
  method           String? // document, database, credit_file, biometric, ...
  providerResponse Json? // verbatim provider payload, for the audit trail
  reviewedById     String? // set when a human overrode the provider
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict, not Cascade: identity verification is evidence, subject to a
  // retention obligation, and must outlive any attempt to remove the account.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications — real-time alerts pushed to the user via WebSocket
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // transfer_status, rate_alert, system
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sessions — per-device JWT tracking for revocation
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id         String    @id @default(uuid())
  userId     String
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Referrals — invite tracking and reward state machine
// ─────────────────────────────────────────────────────────────────────────────

enum ReferralStatus {
  pending
  rewarded
}

model Referral {
  id                   String         @id @default(uuid())
  referrerId           String
  refereeId            String         @unique
  code                 String
  status               ReferralStatus @default(pending)
  rewardAmount         Decimal?       @db.Decimal(20, 4)
  rewardCurrency       String?
  qualifyingTransferId String?
  rewardedAt           DateTime?
  createdAt            DateTime       @default(now())

  // Restrict on both sides: a qualified referral has paid a bonus into the
  // ledger, so the referral row is the justification for a real credit.
  referrer User @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Restrict)
  referee  User @relation("RefereeReferral", fields: [refereeId], references: [id], onDelete: Restrict)

  @@index([referrerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log — required for FINTRAC compliance. Every state-changing action
// must produce an entry here.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  action     String // e.g. "auth.register", "transfer.create", "wallet.fund"
  entityType String?
  entityId   String?
  metadata   Json?

  // Who, denormalised. The relation below is SetNull, so if a user row ever
  // does go the trail would otherwise lose its actor entirely — which is the
  // one thing an audit log may not do. Copied at write time.
  actorEmail String?

  // What changed. `metadata` was carrying whatever each call site felt like:
  // corridor updates stored the incoming DTO (new values only), suspend stored
  // nothing at all. An effectiveness review needs the prior value, the new
  // value and why — so those get columns of their own rather than a convention
  // nobody follows.
  beforeValue Json?
  afterValue  Json?
  reason      String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
