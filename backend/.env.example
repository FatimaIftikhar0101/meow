# Copy this file to .env and fill in values for your environment.

# development | test | production
NODE_ENV=development

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://pc@localhost:5432/meow_dev"

# Port the backend listens on (frontend expects 3000)
PORT=3000

# CORS allow-origin for the frontend dev server
FRONTEND_ORIGIN="http://localhost:3001"

# JWT — must be at least 16 chars, rotated for production
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Global rate limit (windowed)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Money limits (in the user's send currency)
TRANSFER_DAILY_LIMIT=10000

# How often the transfer state machine advances in-flight transfers
TRANSFER_TICK_MS=5000

# Comma-separated list of emails that should be admin on login.
# These accounts use POST /auth/admin/login and see the /admin/* UI.
ADMIN_EMAILS=
