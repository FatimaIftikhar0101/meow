# Copy this file to .env and fill in values for your environment.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local Ubuntu dev where you've created a db matching your linux user:
DATABASE_URL="postgresql://pc@localhost:5432/meow_dev"

# Port the backend listens on (frontend expects 3000)
PORT=3000

# CORS allow-origin for the frontend dev server
FRONTEND_ORIGIN="http://localhost:3001"

# JWT secret — change this for production
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"
