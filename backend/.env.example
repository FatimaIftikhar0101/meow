# Copy this file to .env and fill in values for your environment.

# development | test | production
NODE_ENV=development

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# connection_limit — size of Prisma's client-side pool. Pin it explicitly:
#   the default is (physical CPUs * 2 + 1), which reads the *host* CPU count
#   and so guesses wrong inside a small container. See docs/DEPLOYMENT-CONFIG.md
#   for the value to use per environment (and how it must relate to Postgres
#   max_connections once you run more than one instance).
DATABASE_URL="postgresql://pc@localhost:5432/meow_dev?connection_limit=10&pool_timeout=20"

# Port the backend listens on (frontend expects 3000)
PORT=3000

# Browser-reachable base URL of the web frontend. Used to build the links in
# verification / password-reset emails and the post-OAuth redirect target, so
# it must be a real http(s) URL a mail client can open. This is not the CORS
# setting; see CORS_ORIGINS below.
FRONTEND_ORIGIN="http://localhost:3001"

# Comma-separated CORS allowlist. Empty falls back to FRONTEND_ORIGIN.
#   CORS_ORIGINS="https://app.example.com,https://admin.example.com"
#
# Note this constrains *browsers* only. CORS is enforced by the browser using
# the Origin header; a native (React Native) client sends no Origin and is
# unaffected by this list. Do not rely on it as an access control — it stops
# other websites making authenticated calls on a user's behalf, nothing more.
#
# This list now governs the WebSocket gateways too. They used to declare
# `origin: true` and accept any origin at all, which quietly undid the
# allowlist on the two endpoints that stream a customer's money movements.
#
# For the packaged desktop panel, the origins are:
#   https://tauri.localhost   Windows and Android
#   tauri://localhost         macOS and Linux
CORS_ORIGINS=""

# JWT — must be at least 32 chars (enforced by Joi on boot), rotated for production
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-this-with-32-plus-char-secret-generate-above"
JWT_EXPIRES_IN="7d"

# Global rate limit (windowed)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Money limits (in the user's send currency)
TRANSFER_DAILY_LIMIT=10000

# How often the transfer state machine advances in-flight transfers, how many
# it may advance per tick, and how many of those it runs at once.
#
# Concurrency stays well under the Prisma pool (connection_limit=10 in
# DATABASE_URL) on purpose. Background work that consumes the pool makes HTTP
# requests queue behind it, and a slow scheduler is a far better failure than
# an API that times out.
TRANSFER_TICK_MS=5000
TRANSFER_TICK_BATCH=200
TRANSFER_TICK_CONCURRENCY=4

# Shares WebSocket rooms between backend instances. Optional and inert when
# unset, which is correct on exactly one instance.
#
# Set it BEFORE scaling to two. socket.io keeps rooms in the memory of the
# process that owns them, so without this a customer connected to instance A
# receives nothing when their transfer is advanced on instance B — their
# tracking screen simply stops updating, with no error logged anywhere.
#
# When set, it is treated as required: if the backend cannot reach Redis it
# refuses to start rather than running in the broken half-state this exists to
# prevent. On Railway, add a Redis service and reference it:
#   railway variables --set 'REDIS_URL=${{Redis.REDIS_URL}}'
REDIS_URL=""

# Comma-separated list of emails that should be admin on login.
# These accounts use POST /auth/admin/login and see the /admin/* UI.
ADMIN_EMAILS=

# Google OAuth — get from https://console.cloud.google.com/apis/credentials
# Callback must match: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Gmail SMTP for transactional emails (verification, password reset)
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Runtime tuning
# ─────────────────────────────────────────────────────────────────────────────

# UV_THREADPOOL_SIZE — libuv worker threads. bcrypt (cost 10, ~70ms/hash) runs
# on this pool, so the default of 4 caps concurrent password hashing at 4 and
# makes login bursts queue behind each other.
#
# ⚠ Setting this in .env does NOT work. libuv reads it from the real process
#   environment at startup, before dotenv has run. It must be set by the
#   platform (Railway → service Variables) or by the shell that launches node.
#   Listed here as documentation only. See docs/DEPLOYMENT-CONFIG.md.
# UV_THREADPOOL_SIZE=8

# ─────────────────────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────────────────────

# Resend HTTP API key. Set this in ANY hosted environment.
#
# Managed hosts (Railway, Render, Heroku, Vercel) block outbound SMTP ports
# 25/465/587 so they cannot be used as spam relays. nodemailer there fails with
# `Error: Connection timeout` — a TCP connect that never completes, before a
# password is ever sent, so it looks like a credential problem but is not.
# Sending over HTTPS on 443 avoids the block entirely.
#
# Two API transports. Whichever is set wins, Brevo first, and the SMTP_*
# values below are then ignored. Leave both empty locally to use SMTP
# (Mailhog/Mailpit).
#
# BREVO_API_KEY — use this when you do NOT own a domain yet. Brevo verifies a
# single sender address rather than a whole domain, so you confirm one mailbox
# you control and can then send to anybody. Every provider's shared test sender
# (Resend's onboarding@resend.dev and the rest) refuses to deliver anywhere but
# the account owner's own inbox, and that is not a setting — it is what stops
# anyone sending mail as anyone.
BREVO_API_KEY=

# RESEND_API_KEY — the better choice once a domain exists. A verified domain
# with SPF and DKIM is what actually keeps mail out of spam folders.
RESEND_API_KEY=

# Sender address, independent of transport. Falls back to SMTP_FROM.
#   Brevo:  an address you have verified under Senders. A consumer mailbox
#           (gmail.com and friends) works but fails the recipient's DMARC
#           alignment check, so expect spam placement — fine for testing.
#   Resend: an address on a verified domain, or onboarding@resend.dev, which
#           only delivers to the address the Resend account is registered to.
# Either way: verify a domain before real users sign up.
MAIL_FROM=

# AES-256 key for column encryption (bank account numbers). Base64 of exactly
# 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this makes stored account numbers unrecoverable. Rotating it requires
# a re-encryption pass — see scripts/backfill-encryption.ts.
ENCRYPTION_KEY="replace-with-base64-of-32-random-bytes"
