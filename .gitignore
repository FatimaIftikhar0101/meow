# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored, so this covers every workspace — web/, backend/, mobile/, admin/.
# It was `/node_modules` when the web app lived at the repo root; anchoring it
# there would now miss all four.
node_modules/
.pnp
.pnp.*

# build output
/backend/dist
/web/.next/
/web/out/
/admin/dist/
/mobile/dist/

# Rust build output, 1.4 GB of it. Already ignored by admin/src-tauri/.gitignore
# — this is the belt to that file's braces, for any tool that reads only the
# root ignore file. EAS Build was one such tool; it is now driven by .easignore
# instead, so this rule is no longer what keeps the archive small. It stays
# because the next tool to walk this repo probably has the same blind spot.
/admin/src-tauri/target/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# local-only working notes and filled-in env templates — never committed
*.local.md
*.local.json
*.local.html

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Signing keys, wherever they land. `tauri signer generate -w "$HOME/..."`
# run from cmd.exe or PowerShell does not expand $HOME, so the key materialises
# in a literal `$HOME` directory inside the repo. It happened once.
$HOME/
*.key
!*.key.pub
