# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored, so this covers every workspace — web/, backend/, mobile/, admin/.
# It was `/node_modules` when the web app lived at the repo root; anchoring it
# there would now miss all four.
node_modules/
.pnp
.pnp.*

# build output
/backend/dist
/web/.next/
/web/out/
/admin/dist/
/mobile/dist/

# Rust build output. Already ignored by admin/src-tauri/.gitignore, but that
# one is NESTED, and not every tool that reads ignore files reads nested ones.
# EAS Build does not: it swept 1.4 GB of this into a 417 MB upload on every
# single build until it was listed here as well.
/admin/src-tauri/target/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# local-only working notes and filled-in env templates — never committed
*.local.md
*.local.json
*.local.html

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Signing keys, wherever they land. `tauri signer generate -w "$HOME/..."`
# run from cmd.exe or PowerShell does not expand $HOME, so the key materialises
# in a literal `$HOME` directory inside the repo. It happened once.
$HOME/
*.key
!*.key.pub
